{
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "devCommand": "npm run start",
    "routes": [
        {
            "src": "/.*",
            "headers": {
                "Content-Security-Policy-Report-Only": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://fastly.jsdelivr.net https://cdnjs.cloudflare.com https://giscus.app; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://giscus.app; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self'; frame-src https://giscus.app; object-src 'none'; base-uri 'self'; form-action 'self'"
            },
            "continue": true
        },
        {
            "src": "/reflections/?",
            "has": [
                {
                    "type": "host",
                    "value": "photos.eleni.co"
                }
            ],
            "status": 308,
            "headers": {
                "Location": "https://blog.eleni.co/photos/reflections/"
            }
        },
        {
            "src": "/northern-greece-2025/?",
            "has": [
                {
                    "type": "host",
                    "value": "photos.eleni.co"
                }
            ],
            "status": 308,
            "headers": {
                "Location": "https://blog.eleni.co/photos/northern-greece/"
            }
        },
        {
            "src": "/roisin-murphy-verti-music-hall-2024/?",
            "has": [
                {
                    "type": "host",
                    "value": "photos.eleni.co"
                }
            ],
            "status": 308,
            "headers": {
                "Location": "https://blog.eleni.co/photos/roisin-murphy-verti-music-hall/"
            }
        },
        {
            "src": "/berlin-winter-2024/?",
            "has": [
                {
                    "type": "host",
                    "value": "photos.eleni.co"
                }
            ],
            "status": 308,
            "headers": {
                "Location": "https://blog.eleni.co/photos/berlin/"
            }
        },
        {
            "src": "/greece/?",
            "has": [
                {
                    "type": "host",
                    "value": "photos.eleni.co"
                }
            ],
            "status": 308,
            "headers": {
                "Location": "https://blog.eleni.co/photos/athens-piraeus/"
            }
        },
        {
            "src": "/namibia/?",
            "has": [
                {
                    "type": "host",
                    "value": "photos.eleni.co"
                }
            ],
            "status": 308,
            "headers": {
                "Location": "https://blog.eleni.co/photos/namibia/"
            }
        },
        {
            "src": "/.*",
            "has": [
                {
                    "type": "host",
                    "value": "photos.eleni.co"
                }
            ],
            "status": 308,
            "headers": {
                "Location": "https://blog.eleni.co/photos/"
            }
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "status": 404,
            "dest": "/404"
        }
    ]
}
